<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:l="UnityEngine.Localization">
    <Style src="Menu.uss"/>
    <ui:VisualElement class="menu-page">
        <ui:Label name="pressAnyButton" text="Press Any Button" class="menu-prompt intro-slide is-transparent">
            <Bindings>
                <l:LocalizedString property="text" table="Project Table" entry="MainScene_PressAnyButton"/>
            </Bindings>
        </ui:Label>
        <ui:VisualElement name="mainMenu" class="menu-list menu-reveal is-hidden is-transparent">
            <ui:Button name="start" text="Start Game" focusable="false" class="menu-button">
                <Bindings>
                    <l:LocalizedString property="text" table="Project Table" entry="MainScene_StartGameButton"/>
                </Bindings>
                <ui:VisualElement picking-mode="Ignore" class="menu-icon start-icon"/>
            </ui:Button>
            <ui:Button name="settings" text="Settings" focusable="false" class="menu-button">
                <Bindings>
                    <l:LocalizedString property="text" table="Project Table" entry="MainScene_SettingsButton"/>
                </Bindings>
                <ui:VisualElement picking-mode="Ignore" class="menu-icon settings-icon"/>
            </ui:Button>
            <ui:Button name="quit" text="Exit" focusable="false" class="menu-button">
                <Bindings>
                    <l:LocalizedString property="text" table="Project Table" entry="MainScene_ExitButton"/>
                </Bindings>
                <ui:VisualElement picking-mode="Ignore" class="menu-icon quit-icon"/>
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
